# There is one logical float NaN: every NaN bit pattern compares equal and
# groups together, as in PostgreSQL. `-CAST('NaN' AS DOUBLE)` flips the sign
# bit, producing a NaN with a different bit pattern than the parsed literal.

query BB
SELECT x = y, x IS NOT DISTINCT FROM y
FROM (VALUES (CAST('NaN' AS DOUBLE), -CAST('NaN' AS DOUBLE))) t(x, y)
----
true true

query I
SELECT COUNT(*)
FROM (
  SELECT x
  FROM (VALUES (CAST('NaN' AS DOUBLE)), (-CAST('NaN' AS DOUBLE))) t(x)
  GROUP BY x)
----
1

query I
SELECT COUNT(*)
FROM (
  SELECT DISTINCT x
  FROM (VALUES (CAST('NaN' AS DOUBLE)), (-CAST('NaN' AS DOUBLE)), (0.0), (-0.0)) t(x))
----
2

# The distinct-values accumulator agrees with GROUP BY
query II
SELECT COUNT(DISTINCT x), COUNT(x)
FROM (VALUES (0.0), (-0.0), (CAST('NaN' AS DOUBLE)), (-CAST('NaN' AS DOUBLE))) t(x)
----
2 4

# Join keys
query I
SELECT COUNT(*)
FROM (VALUES (CAST('NaN' AS DOUBLE))) a(x)
JOIN (VALUES (-CAST('NaN' AS DOUBLE))) b(y) ON x = y
----
1

# IN, both with a constant list (static filter) and non-constant list elements
query BB
SELECT CAST('NaN' AS DOUBLE) IN (-CAST('NaN' AS DOUBLE)),
       x IN (1.0, 2.0, y)
FROM (VALUES (CAST('NaN' AS DOUBLE), -CAST('NaN' AS DOUBLE))) t(x, y)
----
true true

# The same semantics hold for REAL (Float32)
query B
SELECT x = y
FROM (VALUES (CAST('NaN' AS REAL), -CAST('NaN' AS REAL))) t(x, y)
----
true

query I
SELECT COUNT(*)
FROM (
  SELECT x
  FROM (VALUES (CAST('NaN' AS REAL)), (-CAST('NaN' AS REAL))) t(x)
  GROUP BY x)
----
1
